{
  "name": "tba-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "migrate:place": "node scripts/migrate-place-fields.js",
    "test:behaviour": "node --test tests/behaviour.test.js",
    "test:payments": "node --test tests/payments.test.js",
    "test:notifications": "node --test --test-concurrency=1 tests/notifications.test.js tests/notifications-negative.test.js",
    "test:business-post-negative": "node --test --test-concurrency=1 tests/business-post-negative.test.js",
    "test": "npm run test:behaviour && npm run test:payments && npm run test:notifications && npm run test:business-post-negative"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "nodemailer": "^6.10.1",
    "stripe": "^22.6.2",
    "ws": "^8.21.3"
  }
}
