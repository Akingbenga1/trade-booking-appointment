PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/trade_booking
JWT_SECRET=dev-trade-booking-secret
MATCH_RADIUS_KM=20
OFFER_WINDOW_SECONDS=120
MATCHING_WINDOW_SECONDS=300
CLIENT_ORIGIN=http://localhost:3000
SEED_ON_START=1

# Mailtrap (magic-link email via background queue)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM=noreply@trade-booking.local

MAGIC_LINK_TTL_MINUTES=60

# Stripe payments (required for Pay for Service checkout)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (Dashboard → Webhooks → endpoint signing secret)
STRIPE_WEBHOOK_SECRET=

# FCM push (web + Android). Leave empty to skip push in local/dev.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Use \n for newlines inside the private key string
FCM_PRIVATE_KEY=

# Notification delivery
# Email booking alerts only if live+push missed after this many seconds
NOTIFY_EMAIL_FALLBACK_SECONDS=120
NOTIFY_MAX_ATTEMPTS=5
