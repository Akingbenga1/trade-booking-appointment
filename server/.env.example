PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/trade_booking
JWT_SECRET=dev-trade-booking-secret
MATCH_RADIUS_KM=20
OFFER_WINDOW_SECONDS=120
MATCHING_WINDOW_SECONDS=300
CLIENT_ORIGIN=http://localhost:3000
SEED_ON_START=1

# Mailtrap (magic-link email via background queue)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM=noreply@trade-booking.local

# OpenCage geocoding (legacy; job/business place UI uses Nominatim via /api/places)
OPENCAGE_API_KEY=
OPENCAGE_STUB=1
# Places proxy stub (Nominatim). Also on when OPENCAGE_STUB=1.
PLACES_STUB=1
MAGIC_LINK_TTL_MINUTES=60

# Stripe payments (leave empty + STRIPE_STUB=1 for local demo checkout page)
STRIPE_SECRET_KEY=
STRIPE_STUB=1
